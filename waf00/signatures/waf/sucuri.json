{
  "name": "Sucuri",
  "type": "WAF",
  "vendor": "GoDaddy / Sucuri",
  "confidence_weight": 35,
  "headers": {
    "x-sucuri-id": ".+",
    "x-sucuri-cache": ".+",
    "server": "Sucuri/Cloudproxy"
  },
  "cookies": [],
  "body_patterns": [
    "Sucuri Website Firewall",
    "sucuri\\.net",
